@page "/register"
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using CrewJet.Auth.Features.Identity
@using CrewJet.Auth.Features.Identity.Services
@using CrewJet.Shared.Features.Identity
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authorization

@inject RegistrationService Registration
@inject IUserDirectory Directory
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Register — CrewJet</PageTitle>

<div class="register-page">
    <div class="register-container">
        <h1>Create your company account</h1>
        <p class="subtitle">Start your free trial. One account per company.</p>

        <EditForm Model="Input" method="post" OnValidSubmit="HandleSubmit" FormName="register">
            <DataAnnotationsValidator/>

            <div class="form-row">
                <div class="form-group">
                    <label>First name</label>
                    <InputText @bind-Value="Input.FirstName" class="form-control"/>
                    <ValidationMessage For="@(() => Input.FirstName)"/>
                </div>
                <div class="form-group">
                    <label>Last name</label>
                    <InputText @bind-Value="Input.LastName" class="form-control"/>
                    <ValidationMessage For="@(() => Input.LastName)"/>
                </div>
            </div>

            <div class="form-group">
                <label>Email address</label>
                <InputText @bind-Value="Input.Email" type="email" class="form-control" autocomplete="email"/>
                <ValidationMessage For="@(() => Input.Email)"/>
            </div>

            <div class="form-group">
                <label>Password</label>
                <InputText @bind-Value="Input.Password" type="password" class="form-control" autocomplete="new-password"/>
                <ValidationMessage For="@(() => Input.Password)"/>
                <small>At least 8 characters</small>
            </div>

            <div class="form-group">
                <label>Company name</label>
                <InputText @bind-Value="Input.CompanyName" class="form-control"/>
                <ValidationMessage For="@(() => Input.CompanyName)"/>
            </div>

            <div class="form-group">
                <label>Desired subdomain</label>
                <div class="subdomain-input">
                    <InputText @bind-Value="Input.DesiredSubdomain" class="form-control" pattern="[a-z0-9-]+"/>
                    <span class="suffix">.@RootDomain</span>
                </div>
                <ValidationMessage For="@(() => Input.DesiredSubdomain)"/>
                <small>Only lowercase letters, numbers, and hyphens</small>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="error-box">@_error</div>
            }

            <button type="submit" class="btn-primary">Create account &amp; continue</button>
        </EditForm>

        <p class="terms">
            By creating an account you agree to our Terms and Privacy Policy.
        </p>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "subdomain")] private string? PrefillSubdomain { get; set; }

    private string? _error;

    private string RootDomain
    {
        get
        {
            // Derive a friendly suffix from the configured host format ("https://{0}.crewjet.test:7168" -> "crewjet.test:7168")
            var format = Configuration["App:ServerHostFormat"] ?? "https://{0}.crewjet.io";
            var sample = string.Format(format, "x");
            var hostStart = sample.IndexOf("//", StringComparison.Ordinal) + 2;
            var afterTenant = sample.IndexOf('.', hostStart);
            return afterTenant > 0 ? sample[(afterTenant + 1)..] : "crewjet.io";
        }
    }

    protected override void OnInitialized()
    {
        Input ??= new InputModel();

        if (!string.IsNullOrWhiteSpace(PrefillSubdomain) && string.IsNullOrWhiteSpace(Input.DesiredSubdomain))
            Input.DesiredSubdomain = PrefillSubdomain.Trim().ToLowerInvariant();
    }

    private async Task HandleSubmit()
    {
        var result = await Registration.RegisterNewCompanyAsync(
            Input.Email, Input.FirstName, Input.LastName, Input.Password,
            Input.CompanyName, Input.DesiredSubdomain);

        if (!result.Success || result.Slug is null)
        {
            _error = result.Message;
            return;
        }

        // Reload the user (it now contains the new tenant membership)
        var user = await Directory.FindByEmailAsync(Input.Email)
                    ?? throw new InvalidOperationException("User missing immediately after creation.");

        var principal = IdentityClaims.CreatePrincipalForUser(user);

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal,
            new AuthenticationProperties { IsPersistent = false });

        var hostFormat = Configuration["App:ServerHostFormat"] ?? "https://{0}.crewjet.io";
        var target = string.Format(hostFormat, result.Slug);

        Navigation.NavigateTo(target, forceLoad: true);
    }

    public sealed class InputModel
    {
        [Required] public string FirstName { get; set; } = string.Empty;
        [Required] public string LastName { get; set; } = string.Empty;
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required, MinLength(8)] public string Password { get; set; } = string.Empty;
        [Required] public string CompanyName { get; set; } = string.Empty;
        [Required, RegularExpression("^[a-z0-9-]+$", ErrorMessage = "Use lowercase letters, numbers, and hyphens only.")]
        public string DesiredSubdomain { get; set; } = string.Empty;
    }
}
