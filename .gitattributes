* text=auto eol=lf

# Force LF for files that run in Linux containers / are read by POSIX tooling
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Windows-specific files keep CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# C# can stay CRLF (your [*] default), but if you prefer normalize to LF, change to text eol=lf
*.cs            text
*.csproj        text
*.slnx          text

# Binary assets
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.db            binary
